PORT=5001
NODE_ENV=development

# Local Postgres (replace USER with your system username)
DATABASE_URL=postgresql://USER@localhost:5432/content_discovery

# Docker Compose Postgres:
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/content_discovery

JWT_SECRET=generate-a-long-random-secret-for-production
YOUTUBE_API_KEY=
CONTENT_SYNC_CRON=*/30 * * * *
