# Root — copy to backend/.env and frontend/.env.local as needed

# Backend (backend/.env)
DATABASE_URL=postgresql://YOUR_USER@localhost:5432/content_discovery
JWT_SECRET=change-me-in-production
PORT=5001
YOUTUBE_API_KEY=
CONTENT_SYNC_CRON=*/30 * * * *

# Frontend (frontend/.env.local)
API_URL=http://localhost:5001
